    "onError": "keep-original",
    "repeat": false,
    "repeatCount": 10,
    "description": "Transformer le texte sur les cellules de la colonne phone à laide de lexpression grel:with(value.toString().replace(/\\s+/, \"\").replace(/\\./, \"\"), p, if(p.startsWith(\"0033\"), \"+\" + p.substring(2), if(p.startsWith(\"0\"), \"+33\" + p.substring(1), p)))"
  },
